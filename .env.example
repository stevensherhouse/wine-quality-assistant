LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=wine-local
# No API key is needed for local mode.
# To use Nebius instead, set LLM_PROVIDER=nebius and fill the next values.
NEBIUS_API_KEY=
# Choose an available chat model from your Nebius console.
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional: external MLflow server; default is a local SQLite database.
# MLFLOW_TRACKING_URI=https://your-mlflow-server.example
